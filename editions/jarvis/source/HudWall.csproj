<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>41.0.1</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF hosts the DeskNest desktop organizer (frames, launcher, rules editor). -->
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HudWall</AssemblyName>
    <RootNamespace>HudWall</RootNamespace>
    <StartupObject>HudWall.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>hud.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- DeskNest sets DPI awareness in the shared manifest. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms and WPF share type names (Application, MessageBox, Color...): each file imports the one it uses. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- DeskNest's App.xaml stays a plain Page (HudWall starts it on its own thread), so it generates no second Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="DeskNest\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hud.ico" LogicalName="HudWall.hud.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)kokorosharp\0.8.4\content\voices\bm_*.npy" Link="voices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
