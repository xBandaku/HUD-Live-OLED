<Window x:Class="DeskNest.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Width="780" Height="540"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        Title="DeskNest launcher">
    <Grid Margin="12">
    <Border Background="{DynamicResource HudLauncherBrush}" BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource HudAccentColor}" />
        </Border.Effect>
        <Grid Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0"
                              PreviewMouseWheel="OnTabsWheel" x:Name="TabsScroller">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>
                <ToggleButton x:Name="KeepOpenButton" Grid.Column="1" Margin="0,0,8,0" Width="30" Height="30"
                              Checked="OnKeepOpenChanged" Unchecked="OnKeepOpenChanged" Focusable="False" Cursor="Hand"
                              ToolTip="Keep open (so you can drag apps in from the desktop or Explorer)">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="2" Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE841;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource DarkTextBox}" Height="30" FontSize="13"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Grid.Column="2" Text="SEARCH ALL TABS" FontFamily="{StaticResource HudFont}" Foreground="{DynamicResource SubtleTextBrush}"
                           Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="SearchHint" />
            </Grid>

            <Grid Grid.Row="1" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
                <ListBox x:Name="Items" Style="{StaticResource TileListStyle}" KeyDown="OnItemsKeyDown"
                         ContextMenuOpening="OnItemsContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False" FontSize="14" />
            </Grid>

            <TextBlock Grid.Row="2" Foreground="{DynamicResource HudAccent2Brush}" FontFamily="{StaticResource HudFont}" FontSize="11" Margin="0,8,0,0"
                       HorizontalAlignment="Center" x:Name="Footer" />
        </Grid>
    </Border>
    <Grid IsHitTestVisible="False">
        <Path Style="{StaticResource HudBracket}" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,16 L0,0 16,0" />
        <Path Style="{StaticResource HudBracket}" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L16,0 16,16" />
        <Path Style="{StaticResource HudBracket}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,16 16,16" />
        <Path Style="{StaticResource HudBracket}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M16,0 L16,16 0,16" />
    </Grid>
    </Grid>
</Window>
