<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DeskNest.Views">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Panel headings use the HUD's monospace -->
    <FontFamily x:Key="HudFont">Consolas, Cascadia Mono, Segoe UI</FontFamily>

    <!-- Theme colors: defaults here, replaced from the HUD palette by HudTheme.Apply -->
    <Color x:Key="HudAccentColor">#38DBFF</Color>
    <SolidColorBrush x:Key="HudAccentBrush" Color="#FF38DBFF" />
    <SolidColorBrush x:Key="HudAccent2Brush" Color="#FFA9F4FF" />
    <SolidColorBrush x:Key="HudRuleBrush" Color="#5938DBFF" />
    <SolidColorBrush x:Key="HudPanelBrush" Color="#C8020A12" />
    <SolidColorBrush x:Key="HudLauncherBrush" Color="#FF020A12" />

    <SolidColorBrush x:Key="TextBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#3D7FB8FF" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#807FB8FF" />
    <SolidColorBrush x:Key="FrameBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#26FFFFFF" />

    <!-- Icon tile shared by frames and the launcher -->
    <DataTemplate x:Key="ItemTileTemplate" DataType="{x:Type views:ItemView}">
        <StackPanel Width="{Binding TileWidth}" Margin="2,4" Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}">
            <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,2,0,4" />
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="34" LineHeight="16" LineStackingStrategy="BlockLineHeight" Margin="2,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Corner bracket on frames and the launcher -->
    <Style x:Key="HudBracket" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource HudAccentBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <ItemsPanelTemplate x:Key="WrapItemsPanel">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Thin, unobtrusive scrollbar for the dark icon grids -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="0" Background="{DynamicResource FrameBorderBrush}" Margin="0,2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileListStyle" TargetType="ListBox">
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="ItemTemplate" Value="{StaticResource ItemTileTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TileItemStyle}" />
        <Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="GlyphButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="2" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource FrameBorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Launcher tab header -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="0" Padding="14,5" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
